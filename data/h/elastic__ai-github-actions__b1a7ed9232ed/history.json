      ],
      "tree_sha": "a7c8748c8d8f3b9905fa456cf68d7ba850fe2186",
      "html_url": "https://github.com/elastic/ai-github-actions/commit/50bcf4beff11725ff5f56cd7511df63ce13ffc25",
      "verification_verified": true,
      "verification_reason": "valid",
      "actor_type": "agent",
      "attribution_class": "ambiguous_multiple_agents",
      "agent_name": "Claude Code;GitHub Copilot",
      "attribution_confidence": "conflict",
      "attribution_evidence": "GitHub Copilot:copilot_swe_agent_email;Claude Code:claude_anthropic_coauthor",
      "md_changes": [
        {
          "source_key": "elastic/ai-github-actions:.github/workflows/gh-aw-stale-issues-investigator.md",
          "source_full_name": "elastic/ai-github-actions",
          "md_path": ".github/workflows/gh-aw-stale-issues-investigator.md",
          "commit_sha": "50bcf4beff11725ff5f56cd7511df63ce13ffc25",
          "committed_at": "2026-02-28T21:49:15Z",
          "event_status": "renamed",
          "previous_path": ".github/workflows/gh-aw-stale-issues.md",
          "file_additions": 20,
          "file_deletions": 5,
          "file_changes": 25,
          "file_patch": "@@ -1,7 +1,7 @@\n ---\n inlined-imports: true\n-name: \"Stale Issues\"\n-description: \"Find open issues that appear to already be resolved and recommend closing them\"\n+name: \"Stale Issues Investigator\"\n+description: \"Find open issues that appear to already be resolved, label them as stale, and file a report\"\n imports:\n   - gh-aw-fragments/elastic-tools.md\n   - gh-aw-fragments/runtime-setup.md\n@@ -44,6 +44,11 @@ on:\n         type: string\n         required: false\n         default: \"\"\n+      stale-label:\n+        description: \"Label used to mark stale issues\"\n+        type: string\n+        required: false\n+        default: \"stale\"\n       title-prefix:\n         description: \"Title prefix for created issues (e.g. '[stale-issues]')\"\n         type: string\n@@ -56,7 +61,7 @@ on:\n   bots:\n     - \"${{ inputs.allowed-bot-users }}\"\n concurrency:\n-  group: stale-issues\n+  group: stale-issues-investigator\n   cancel-in-progress: true\n permissions:\n   contents: read\n@@ -75,7 +80,12 @@ safe-outputs:\n     max: 1\n     title-prefix: \"${{ inputs.title-prefix }} \"\n     close-older-issues: true\n-    expires: 7d\n+    expires: 2d\n+  add-labels:\n+    max: 10\n+    target: \"*\"\n+    allowed:\n+      - \"${{ inputs.stale-label }}\"\n timeout-minutes: 60\n steps:\n   - name: Prescan open issues\n@@ -104,7 +114,7 @@ steps:\n     run: eval \"$SETUP_COMMANDS\"\n ---\n \n-Find open issues that are very likely already resolved and recommend them for closure. You do NOT close issues yourself — you file a report listing candidates with evidence.\n+Find open issues that are very likely already resolved, label them as stale candidates, and file a report.\n \n ### Data Gathering\n \n@@ -172,6 +182,7 @@ Only flag an issue if you have **strong evidence** from at least one of these ca\n \n ### What to Skip\n \n+- Issues already labeled `${{ inputs.stale-label }}` — they are already tracked and will be processed by the remediator\n - Issues with recent activity (comments in the last 14 days) — someone is still working on them\n - Issues labeled `epic`, `tracking`, `umbrella`, or similar meta-labels — these are intentionally kept open\n - Issues where the resolution is ambiguous or you aren't sure\n@@ -180,6 +191,10 @@ Only flag an issue if you have **strong evidence** from at least one of these ca\n \n **When in doubt, skip the issue.** False positives waste maintainer time and erode trust in the report. Only include issues where you are highly confident they are resolved.\n \n+### Labeling\n+\n+For each issue included in the report, call `add_labels` with the `${{ inputs.stale-label }}` label on that issue. This starts a 30-day grace period — maintainers can remove the label to prevent automatic closure by the remediator.\n+\n ### Issue Format\n \n **Issue title:** Stale issues report — [count] issues likely resolved",
