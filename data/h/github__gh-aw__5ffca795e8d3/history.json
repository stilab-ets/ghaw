      "message": "Establish ESLint Linter Factory for actions/setup/js and add dedicated ESLint daily workflows (#41938)",
      "parent_shas": [
        "5b7ef28a594bd0a936367cd130726c4980bc2637"
      ],
      "tree_sha": "6d59c82c938f627c771603ffba0def39f38fb6f2",
      "html_url": "https://github.com/github/gh-aw/commit/35777da04c8f5230a9627bc0ad01f8a6b98dd72c",
      "verification_verified": true,
